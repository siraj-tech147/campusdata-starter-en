# STUDENT CONTEXT: PREPARATION | template to keep without real private values
# TO PREPARE / ADAPT: Generate your .env as described in the course; CHANGE_ME is not a password to use.
# EXPECTED CHECK: Check that Git ignores .env without printing its content.
#
# Copy/generate .env as described in the preparation guide; never commit .env.
POSTGRES_USER=campus
POSTGRES_DB=campus
# Placeholder only: generate a hexadecimal secret for the lab.
# Changing this value does not change the password of an already initialised database.
POSTGRES_PASSWORD=CHANGE_ME
# Replace CHANGE_ME with the same hexadecimal secret as above.
# This address targets Compose/Kubernetes. For the API on the laptop, replace
# the host db with 127.0.0.1 in the terminal; for tests use campus_test.
DATABASE_URL=postgresql+psycopg://campus:CHANGE_ME@db:5432/campus
